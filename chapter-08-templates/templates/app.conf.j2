# ==============================================
# Application Configuration
# Environment: {{ app_env | default('production') | upper }}
# Generated by Ansible on {{ ansible_date_time.date }}
# ==============================================

[app]
name = {{ app_name }}
version = {{ app_version | default('1.0.0') }}
port = {{ app_port | default(8080) }}
debug = {{ app_debug | default(false) | lower }}

[database]
host = {{ db_host | default('localhost') }}
port = {{ db_port | default(5432) }}
name = {{ db_name | default(app_name + '_db') }}
user = {{ db_user | default(app_name + '_user') }}
# password stored in vault

[logging]
level = {{ log_level | default('INFO') }}
file = /var/log/{{ app_name }}/app.log
max_size = {{ log_max_size | default('100M') }}
backup_count = {{ log_backup_count | default(5) }}

[features]
{% for feature, enabled in app_features.items() %}
{{ feature }} = {{ enabled | lower }}
{% endfor %}
