<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>{{ app_name | default('My App') | title }}</title>
    <style>
        body { font-family: Arial, sans-serif; margin: 40px; background: #f5f5f5; }
        .container { background: white; padding: 30px; border-radius: 8px; max-width: 600px; }
        h1 { color: #333; }
        .badge { display: inline-block; padding: 4px 10px; border-radius: 4px;
                 background: {% if server_env | default('production') == 'production' %}#e74c3c{% else %}#2ecc71{% endif %};
                 color: white; font-size: 12px; }
        table { width: 100%; border-collapse: collapse; margin-top: 20px; }
        td { padding: 8px; border-bottom: 1px solid #eee; }
        td:first-child { font-weight: bold; color: #666; }
    </style>
</head>
<body>
    <div class="container">
        <h1>{{ app_name | default('My App') | title }}
            <span class="badge">{{ server_env | default('production') | upper }}</span>
        </h1>
        <p>Welcome! This page was generated by Ansible using Jinja2 templates.</p>

        <table>
            <tr><td>Hostname</td><td>{{ ansible_hostname }}</td></tr>
            <tr><td>IP Address</td><td>{{ ansible_default_ipv4.address }}</td></tr>
            <tr><td>OS</td><td>{{ ansible_distribution }} {{ ansible_distribution_version }}</td></tr>
            <tr><td>App Version</td><td>{{ app_version | default('1.0.0') }}</td></tr>
            <tr><td>Deployed</td><td>{{ ansible_date_time.iso8601 }}</td></tr>
        </table>

{% if enabled_features is defined and enabled_features | length > 0 %}
        <h3>Enabled Features</h3>
        <ul>
{% for feature in enabled_features %}
            <li>{{ feature | replace('_', ' ') | title }}</li>
{% endfor %}
        </ul>
{% endif %}
    </div>
</body>
</html>
