[loadbalancers]
lb-1  ansible_host=34.1.2.3 private_ip=10.20.0.2

[appservers]
app-1 ansible_host=34.1.2.4 private_ip=10.20.0.3
app-2 ansible_host=34.1.2.5 private_ip=10.20.0.4

[dbservers]
db-1  ansible_host=34.1.2.6 private_ip=10.20.0.5

[all:vars]
ansible_user=ansible
ansible_ssh_private_key_file=../infra/keys/lab
ansible_python_interpreter=/usr/bin/python3
