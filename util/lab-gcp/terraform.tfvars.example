# Copy to terraform.tfvars and edit.
project_id = "my-gcp-project-id"   # gcloud config get-value project

# e2-micro is free-tier eligible only in us-west1, us-central1, us-east1
region = "us-central1"
zone   = "us-central1-a"

instance_count = 3
machine_type   = "e2-micro"

# Key pair lives in util/keys (gitignored). Create it from the repo root with:
#   ssh-keygen -t ed25519 -f util/keys/ansible-lab -N ""
# Defaults already point there, so nothing to change unless you keep the key elsewhere:
# ssh_public_key       = file("../keys/ansible-lab.pub")
# ssh_private_key_file = "../keys/ansible-lab"

# Optional: reuse an existing VPC/subnet instead of creating one
# create_network = false
# vpc_name       = "my-existing-vpc"
# subnet_name    = "my-existing-subnet"

# Optional: lock SSH/HTTP down to your own IP
# allowed_cidr = "203.0.113.10/32"
